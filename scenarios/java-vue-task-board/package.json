{
  "name": "java-vue-task-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "node scripts/java-backend.mjs serve",
    "dev:web": "vite",
    "lint": "node scripts/java-backend.mjs lint && eslint --max-warnings 0 frontend/src",
    "build": "vite build",
    "test:api": "node --test tests/api/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs"
  },
  "dependencies": {
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@fission-ai/openspec": "2.1.1",
    "@vitejs/plugin-vue": "6.0.11",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "playwright": "1.65.1",
    "vite": "8.3.8",
    "vue-eslint-parser": "10.4.2"
  }
}
