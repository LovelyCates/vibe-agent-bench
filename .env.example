# Optional startup defaults. Copy this file to .env before running npm start.
# DeepSeek and compatible settings can also be saved and switched in the web UI.
# Existing OpenAI configuration remains the default. DeepSeek and compatible use Chat Completions.
VIBE_BENCH_PROVIDER=openai

# DeepSeek example (use only one set of settings in .env):
# VIBE_BENCH_PROVIDER=deepseek
# VIBE_BENCH_BASE_URL=https://api.deepseek.com
# VIBE_BENCH_MODEL=deepseek-flash
# VIBE_BENCH_API_KEY=

# OpenAI-compatible service inside your network:
# VIBE_BENCH_PROVIDER=compatible
# VIBE_BENCH_BASE_URL=http://model.intra:8000/v1
# VIBE_BENCH_MODEL=your-server-model-id
# VIBE_BENCH_API_KEY=
# VIBE_BENCH_ALLOW_NO_API_KEY=true

# Only if DSH is installed outside the project / PATH:
# VIBE_BENCH_DSH_BIN=C:\Tools\dsh.exe
